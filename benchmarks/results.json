  "tests": [
    {
      "name": "scan",
      "title": "Test 1 \u2014 Scan: one literal in a large haystack",
      "description": "A plain literal search for a single needle that occurs once. This is the classic log-grep workload and the automata engine's home turf: rurex scans with SIMD-accelerated prefilters, `re` steps its backtracking VM byte by byte. Two parameters are swept: haystack length, and where in the haystack the needle sits (position 100% is the worst case: the whole text must be scanned).",
      "pattern": "the-needle-string",
      "data_example": "jumps delta data node item brown lorem fox alpha item world alpha text amet node lazy fox alpha the the-needle-string \u2026",
      "op": "search",
      "sweeps": [
        {
          "param": "data_size",
          "unit": "KB",
          "label": "haystack size (needle at the end)",
          "points": [
            {
              "value": 64,
              "re_s": 7.668020296841859e-05,
              "rurex_s": 8.949201777577401e-06
            },
            {
              "value": 256,
              "re_s": 0.00031136500416323543,
              "rurex_s": 3.634646190330386e-05
            },
            {
              "value": 1024,
              "re_s": 0.001262084529735148,
              "rurex_s": 0.0001431663460098207
            },
            {
