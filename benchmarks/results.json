    {
      "name": "pathological",
      "title": "Test 3 \u2014 Pathological: catastrophic backtracking",
      "description": "The pattern `(x+x+)+y` never matches a run of x's, and for a backtracking engine the number of ways to distribute the x's across the groups grows exponentially: `re`'s time doubles with every two extra characters. A finite-automata engine cannot backtrack, so rurex's time grows linearly with input length \u2014 at n=28 it answers in nanoseconds where `re` would run for longer than the universe's age. This is a safety property (ReDoS resistance), not a speed feature.",
      "pattern": "(x+x+)+y",
      "data_example": "xxxxxxxxxxxxxxxxxxxxxxxx  (n=24 of the sweep; no y, so nothing ever matches)",
      "op": "guarded_search",
      "sweeps": [
        {
          "param": "input_length",
          "unit": "chars",
          "label": "input length n, text = \"x\" * n",
