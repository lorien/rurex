    {
      "name": "extract",
      "title": "Test 2 \u2014 Extraction: findall over match-dense data",
      "description": "Digit-run extraction (`findall`) over word filler \u2014 the regime where `re` wins today: matches are small and everywhere, so the cost is dominated by building Python match objects, and rurex currently constructs each result through Python-level slicing. Two parameters are swept: data length at fixed density, and match density at fixed length (isolating the per-match cost from the scan cost).",
      "pattern": "\\d{3,4}",
      "data_example": "7685 value word word beta beta lorem node alpha word value text value alpha word value value node alpha node text beta node text node text beta beta beta alpha alpha beta value lorem value alpha lorem node text lorem node alpha word beta node beta node lorem text alpha lorem word beta text word word lorem alpha beta node alpha text alpha text lorem text beta alpha beta text node lorem alpha value",
      "op": "findall",
      "sweeps": [
